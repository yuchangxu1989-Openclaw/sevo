# npm package: include compiled .js files, exclude dev/internal artifacts
node_modules/
state/
*.log
web/
docs/
tests/
artifacts/
skill/

# Internal runtime
.env
.env.*
logs/
.cache/
coverage/
data/active-index.json
data/lifecycle-scans.jsonl
data/pipelines/

# Source TypeScript is omitted; V2 runtime JavaScript is allowlisted in package.json.
src/**/*.ts
tsconfig.json

# Internal files not for distribution
.openclaw/
memory/
*.secret
*.key
openclaw.json

# Tests
**/__tests__/
**/*.test.ts
**/*.test.js

.DS_Store
.gitignore
.npmignore
