{
  "name": "sevo-pipeline",
  "version": "1.13.7",
  "description": "SEVO — Automated software delivery pipeline for AI agents (Specify → Execute → Verify → Operate)",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./plugin": "./index.js",
    "./legacy": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "sevo": "./bin/sevo.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "test": "vitest run",
    "test:fr28-fr29": "vitest run src/scan/__tests__/l3-runtime-verifier.test.ts src/scan/__tests__/tiered-scan-orchestrator.test.ts src/stages/__tests__/clean-install-verification-stage.test.ts",
    "doctor": "node -e \"require('./index.js')\" 2>&1 | head -5",
    "postinstall": "bash scripts/init.sh",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "openclaw",
    "pipeline",
    "sevo",
    "ai-agent",
    "software-delivery",
    "vibe-coding",
    "ai-development",
    "automated-pipeline",
    "code-quality",
    "ci-cd",
    "agent-pipeline",
    "spec-driven",
    "ai-coding",
    "development-automation"
  ],
  "author": "OpenClaw SEVO Team <yuchangxu1989@gmail.com>",
  "license": "MIT",
  "files": [
    "dist/",
    "!dist/__tests__/",
    "!dist/**/__tests__/",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map",
    "lib/",
    "src/*.js",
    "src/context-injection/*.js",
    "data/*-vectors.json",
    "data/v2-enabled",
    "bin/",
    "templates/",
    "scripts/",
    "index.js",
    "openclaw.plugin.json",
    "bridge.js",
    "label-protocol.js",
    "methodology.js",
    "role-templates.js",
    "sevo-init.js",
    "task-mapper.js",
    "event-log.js",
    "advance-prompt-templates.js",
    "utils.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.19.17",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "commander": "^12.1.0"
  },
  "sevo": {
    "projectType": "cli"
  }
}
